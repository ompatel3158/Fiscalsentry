# ==========================================
# FISCALSENTRY ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Google Gemini Multimodal API Key (Get at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Firebase Configuration (Cloud Firestore, Storage, Auth)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# 3. Google Workspace & 3rd-Party Webhooks (Optional for live dispatch)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK
CUSTOM_ERP_WEBHOOK_URL=https://api.yourcompany.com/v1/invoices
